{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OPM Flow",
  "scopeName": "source.opm-flow",
  "patterns": [
    { "include": "#comments" },
    { "include": "#sections" },
    { "include": "#end-keyword" },
    { "include": "#actionx-control" },
    { "include": "#udq-control" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#variables" },
    { "include": "#udq-functions" },
    { "include": "#operators" },
    { "include": "#defaults" },
    { "include": "#numbers" },
    { "include": "#terminators" },
    { "include": "#unquoted-strings" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-dash.opm-flow",
      "match": "--.*$"
    },
    "sections": {
      "name": "entity.name.function.section.opm-flow",
      "match": "^\\s*(RUNSPEC|GRID|EDIT|PROPS|REGIONS|SOLUTION|SUMMARY|SCHEDULE)\\s*$"
    },
    "end-keyword": {
      "name": "keyword.control.end.opm-flow",
      "match": "^\\s*END\\s*$"
    },
    "actionx-control": {
      "name": "keyword.control.actionx.opm-flow",
      "match": "^\\s*(ACTIONX|ENDACTIO)(?=\\s|$)"
    },
    "udq-control": {
      "name": "keyword.other.udq-control.opm-flow",
      "match": "^\\s*(ASSIGN|DEFINE|UNITS|UPDATE)(?=\\s)"
    },
    "keywords": {
      "name": "keyword.control.opm-flow",
      "match": "^[A-Z][A-Z0-9_+-]*(?=\\s*(?:--|/|$))"
    },
    "strings": {
      "name": "string.quoted.single.opm-flow",
      "begin": "'",
      "end": "'",
      "patterns": [
        { "name": "constant.character.escape.opm-flow", "match": "\\\\." }
      ]
    },
    "variables": {
      "name": "variable.other.template.opm-flow",
      "match": "<[A-Z][A-Z0-9_]*>"
    },
    "udq-functions": {
      "name": "support.function.udq.opm-flow",
      "match": "\\b(ABS|DEF|EXP|IDV|LN|LOG|NINT|RANDN|RANDNORM|RANDU|SORTA|SORTD|UNDEF|SUM|AVEA|AVEG|AVEH|MIN|MAX|PROD|NORM1|NORM2|NORMI|ELDLR|ELDLM)(?=\\s*\\()"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.opm-flow",
          "match": "(?<=\\s)(>=|<=|==|!=|>|<|=)(?=\\s)"
        },
        {
          "name": "keyword.operator.logical.opm-flow",
          "match": "\\b(AND|OR)\\b"
        }
      ]
    },
    "defaults": {
      "name": "constant.language.default.opm-flow",
      "match": "(?<![A-Za-z0-9_])\\d+\\*"
    },
    "numbers": {
      "name": "constant.numeric.opm-flow",
      "match": "(?<![A-Za-z_])[-+]?[0-9]*\\.?[0-9]+([eE][-+]?[0-9]+)?(?![A-Za-z_*])"
    },
    "terminators": {
      "match": "((?<=\\S)\\s*/|^\\s*/)(.*)$",
      "captures": {
        "1": { "name": "punctuation.terminator.opm-flow" },
        "2": { "name": "comment.line.terminator-trailing.opm-flow" }
      }
    },
    "unquoted-strings": {
      "name": "string.unquoted.opm-flow",
      "match": "(?<![A-Za-z0-9_])[A-Z][A-Z0-9_+-]*(?![A-Za-z0-9_])"
    }
  }
}
